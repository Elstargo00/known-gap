DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Postgres (exposed on host port 5433 via docker-compose)
DATABASE_URL=postgresql://known_gap:known_gap@localhost:5433/known_gap

# Embeddings
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# Chunking (character-based; ~4 chars ≈ 1 token)
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# Upload limits
MAX_UPLOAD_MB=20

# LLM (Anthropic primary, Gemini fallback on transient errors only)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=gemini-2.5-flash
ANSWER_MAX_TOKENS=1024

# Retrieval
TOP_K=10

# Concept extraction (cheap/fast model; fallback stack still applies)
CONCEPT_EXTRACTION_MODEL=claude-haiku-4-5-20251001
CONCEPT_EXTRACTION_MAX_TOKENS=1024

# Graph Expert (relation-proposing LLM; runs as a background task — Opus is fine)
GRAPH_EXPERT_MODEL=claude-opus-4-7
GRAPH_EXPERT_MAX_TOKENS=2048
# How many edges (and possibly new nodes) the expert proposes per seed concept
GRAPH_EXPERT_DEGREE=3

# Knowledge scoring (per-concept "known_score" lives in [0, 100])
KNOWN_SCORE_THRESHOLD=50
KNOWN_SCORE_INCREMENT=10
KNOWN_SCORE_DECREMENT=10
KNOWN_SCORE_INITIAL=0

# Graph traversal & tool-calling
CONCEPT_NEIGHBORHOOD_MAX_HOPS=2
TOOL_MAX_ITERATIONS=6

# Knowledge Graph (FalkorDB Cloud for prod; any reachable instance for local dev)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Auth (shared HS256 secret with the NextJS frontend that mints JWTs)
JWT_SECRET=
JWT_ALGORITHM=HS256
