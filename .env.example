DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Postgres (exposed on host port 5433 via docker-compose)
DATABASE_URL=postgresql://known_gap:known_gap@localhost:5433/known_gap

# Embeddings
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# Chunking (character-based; ~4 chars ≈ 1 token)
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# Upload limits
MAX_UPLOAD_MB=20
